<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>uk.gov.justice</groupId>
    <artifactId>maven-super-pom</artifactId>
    <version>25.104.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Maven Super Pom</name>
    <description>Top-level parent super POM for all Common Platform projects</description>

    <organization>
        <name>Ministry of Justice</name>
        <url>http://www.justice.gov.uk/</url>
    </organization>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <cpp.repo.owner>CJSCommonPlatform</cpp.repo.owner>
        <cpp.repo.owner-lower>cjscommonplatform</cpp.repo.owner-lower>
        <cpp.repo.name>maven-super-pom</cpp.repo.name>
        <cpp.scm.git.url>git@github.com:${cpp.repo.owner}/${cpp.repo.name}.git</cpp.scm.git.url>
        <cpp.scm.connection>scm:git:${cpp.scm.git.url}/</cpp.scm.connection>
        <cpp.scm.developerConnection>${project.scm.connection}</cpp.scm.developerConnection>
        <cpp.scm.url>https://github.com/${cpp.repo.owner}/${cpp.repo.name}</cpp.scm.url>

        <!-- Declared here, and only here, so that every inheriting pom shares a single value.
             Do not redeclare these in a child pom - a local copy silently overrides this one. -->

        <!-- Drives BOTH the liquibase-core library and the liquibase-maven-plugin. They are
             released in lockstep, so keep them on the same version. -->
        <liquibase.version>5.0.3</liquibase.version>

        <plugins.buildhelper.version>3.6.0</plugins.buildhelper.version>
        <plugins.buildnumber.version>3.2.0</plugins.buildnumber.version>
        <plugins.maven.assembly.version>3.7.1</plugins.maven.assembly.version>
        <plugins.maven.clean.version>3.2.0</plugins.maven.clean.version>
        <plugins.maven.compiler.version>3.15.0</plugins.maven.compiler.version>
        <plugins.maven.dependency.version>3.6.1</plugins.maven.dependency.version>
        <plugins.maven.deploy.version>3.1.4</plugins.maven.deploy.version>
        <plugins.maven.enforcer.version>3.4.1</plugins.maven.enforcer.version>
        <plugins.maven.failsafe.version>3.5.6</plugins.maven.failsafe.version>
        <plugins.maven.install.version>3.1.4</plugins.maven.install.version>
        <plugins.maven.jar.version>3.5.0</plugins.maven.jar.version>
        <plugins.maven.javadoc.version>3.6.3</plugins.maven.javadoc.version>
        <plugins.maven.resources.version>3.4.0</plugins.maven.resources.version>
        <plugins.maven.site.version>3.12.1</plugins.maven.site.version>
        <plugins.maven.source.version>3.3.1</plugins.maven.source.version>
        <plugins.maven.surefire.version>3.5.6</plugins.maven.surefire.version>
        <plugins.maven.wagon.version>3.5.3</plugins.maven.wagon.version>
        <plugins.maven.war.version>3.5.1</plugins.maven.war.version>
        <plugins.pitest.version>1.19.1</plugins.pitest.version>
        <plugins.versions.version>2.16.2</plugins.versions.version>

    </properties>

    <scm>
        <connection>${cpp.scm.connection}</connection>
        <developerConnection>${cpp.scm.developerConnection}</developerConnection>
        <url>${cpp.scm.url}</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>cjscommonplatform-maven-repository</id>
            <url>https://maven.cloudsmith.io/cjscommonplatform/maven-repository</url>
        </repository>
    </distributionManagement>

</project>
